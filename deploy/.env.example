# 这里只能填写坚果云“第三方应用密码”，不要填写网页登录密码。
NUTSTORE_USERNAME=your-account@example.com
NUTSTORE_APP_PASSWORD=replace-with-nutstore-app-password
NUTSTORE_BACKUP_DIRECTORY=六爻排盘备份
NUTSTORE_WEBDAV_URL=https://dav.jianguoyun.com/dav/
MAX_BACKUP_BYTES=20971520
LOCAL_BACKUP_ROOT=/data
# 配置 rclone 后填写远端名称，逗号分隔。例如：nutstore,yandex,box
RCLONE_TARGETS=
RCLONE_CONFIG=/config/rclone/rclone.conf
RCLONE_BACKUP_DIRECTORY=六爻排盘备份
